# Local results / large example data — NOT committed to git.
# Several of these exceed GitHub's 100MB hard per-file push limit
# (488IMb_tissue.xlsx / 488IMb_background.xlsx are 165MB each,
# 1b_P487_Healthy_sez1.h5ad is 97MB, and any merged/processed .h5ad output
# regularly exceeds 100MB), so committing them would break `git push`
# outright, not just bloat history. Keep large example data out-of-repo
# (e.g. Zenodo/cloud storage + a download script) rather than switching to
# Git LFS unless there's a specific reason to version large binaries.
/results/
/results_benchmark/
*.h5ad
/488IMb_tissue.xlsx
/488IMb_background.xlsx
/20240423_feature_table.xlsx
/Non Responder/
/Responder/
/data/

# Corrupted / unreferenced by any code — see CHANGELOG. Keep out of git
# until confirmed needed; delete outright if not.
local_enrichment_db_v2.sqlite

# Personal notes unrelated to this package
Single Cell Samu.md
.obsidian/

# Personal dev-scratch / benchmarking scripts and internal process notes —
# useful to keep locally, not appropriate for a public-facing repo (informal
# tone, personal notebook references, ad-hoc one-off debugging tools).
# drugbank.db is NOT here: it's intentionally gone for good, since it's a
# redundant duplicate of src/mortis/data/drugbank.db (the package now
# bundles and auto-resolves its own copy — see filter_drugs()).
/pypi_upload_guide.md
/benchmark_full_pipeline.py
/run_benchmark.py
/test.py

# Private patient data — NEVER commit. Local test fixture only.
/test_data/
